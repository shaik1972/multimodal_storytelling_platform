# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real keys.

# Groq (for text generation — fast, free tier, no credit card)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Current free-tier model; change this if Groq changes model availability.
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (text generation — free tier)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# IBM watsonx.ai (for text generation via Granite — optional, used if GROQ_API_KEY is absent)
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here
IBM_API_URL=https://us-south.ml.cloud.ibm.com

# Hugging Face (for image generation via FLUX.1 schnell)
# Get a free token at: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Optional local text-to-video engine command. It must generate real video and
# write the resulting MP4 to the path substituted for {out}.
# TEXT_VIDEO_LOCAL_COMMAND=your-local-video-engine --prompt "{prompt}" --out "{out}"

# Hosted text-to-video (fallback when local generation is unavailable)
# TEXT_VIDEO_API_KEY=your_text_video_api_key_here
# TEXT_VIDEO_API_URL=https://your-provider.example/v1
# TEXT_VIDEO_MODEL=your_video_model_name
# No video provider is bundled or configured by default.
